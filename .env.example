# Isi dengan nilai asli dari TikTok Developer Portal -> Manage apps -> aplikasi yang sama -> Basic Information
# Gunakan Client Key, BUKAN App ID atau Client Secret. Jangan commit file .env ke GitHub.
TIKTOK_CLIENT_KEY=isi_client_key_kamu
TIKTOK_CLIENT_SECRET=isi_client_secret_kamu

# Harus sama persis dengan Redirect URI yang terdaftar pada produk Login Kit.
# Gunakan domain production yang akan dipakai untuk login; path callback adalah /api/callback.
TIKTOK_REDIRECT_URI=https://nama-app-kamu.vercel.app/api/callback
