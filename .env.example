# Salin file ini jadi ".env" untuk testing lokal, atau isi langsung
# di Vercel Dashboard -> Project -> Settings -> Environment Variables

# Didapat dari developers.tiktok.com -> App kamu -> Basic Information
TIKTOK_CLIENT_KEY=isi_client_key_kamu
TIKTOK_CLIENT_SECRET=isi_client_secret_kamu

# Harus SAMA PERSIS dengan yang didaftarkan di TikTok Developer Portal
# (Login Kit / Content Posting API -> Redirect URI)
# Contoh setelah deploy ke Vercel:
TIKTOK_REDIRECT_URI=https://nama-app-kamu.vercel.app/api/callback
